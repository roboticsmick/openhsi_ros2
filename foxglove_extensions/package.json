{
  "name": "foxglove-hypercube-panel",
  "displayName": "Hypercube Waterfall Panel",
  "description": "Visualize hyperspectral line scan data as an RGB waterfall with spectrum viewer",
  "version": "1.2.1",
  "license": "MIT",
  "author": {
    "name": "Michael Venz"
  },
  "publisher": "rangerbot",
